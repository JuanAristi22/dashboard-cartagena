# Strava API Application (strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Supabase project (Settings -> API). Service role key is server-side only, never expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret you invent yourself. Protects /api/auth/strava-login (so a stranger can't link
# their own Strava account to your dashboard) and /api/sync-strava (so only you/the cron job
# can trigger a sync). Put the same value in the dashboard's manual "Sync" button later.
APP_SECRET=
